{
  "manifest_version": 3,
  "name": "Photo Review Bridge",
  "version": "0.4.7",
  "description": "A local review HUD for Google Photos: accept, reject, rate and select loaded photos. No uploads or deletion.",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://photos.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Show Google Photos Review HUD"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photos.google.com/*"
      ],
      "js": [
        "hud-core.js",
        "hud.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'"
  }
}
